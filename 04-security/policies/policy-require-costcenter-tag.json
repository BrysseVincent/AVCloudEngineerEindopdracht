{
  "$schema": "https://schema.management.azure.com/schemas/2019-09-01/policyDefinition.json#",
  "name": "require-costcenter-tag",
  "displayName": "Require tag 'CostCenter' on all resources",
  "description": "Enforces the presence of the required 'CostCenter' tag on all resources. Allowed values: CC-IT-001, CC-IT-002, CC-OPS-001.",
  "mode": "Indexed",
  "metadata": {
    "category": "Tags",
    "version": "1.0.0",
    "author": "Vincent Brysse"
  },
  "parameters": {
    "effect": {
      "type": "String",
      "metadata": {
        "displayName": "Effect",
        "description": "The effect determines what happens when the policy rule is evaluated to match"
      },
      "allowedValues": [
        "Deny",
        "Audit",
        "Disabled"
      ],
      "defaultValue": "Deny"
    }
  },
  "policyRule": {
    "if": {
      "anyOf": [
        {
          "field": "tags['CostCenter']",
          "exists": "false"
        },
        {
          "field": "tags['CostCenter']",
          "notIn": ["CC-IT-001", "CC-IT-002", "CC-OPS-001"]
        }
      ]
    },
    "then": {
      "effect": "[parameters('effect')]"
    }
  }
}
