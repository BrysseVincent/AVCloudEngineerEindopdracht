{
  "$schema": "https://schema.management.azure.com/schemas/2019-09-01/policyDefinition.json#",
  "name": "require-owner-tag",
  "displayName": "Require tag 'Owner' on all resources",
  "description": "Enforces the presence of the required 'Owner' tag on all resources. Must be a valid Contoso email address.",
  "mode": "Indexed",
  "metadata": {
    "category": "Tags",
    "version": "1.0.0",
    "author": "delaware cloud practice"
  },
  "parameters": {
    "effect": {
      "type": "String",
      "metadata": {
        "displayName": "Effect",
        "description": "The effect determines what happens when the policy rule is evaluated to match"
      },
      "allowedValues": [
        "Deny",
        "Audit",
        "Disabled"
      ],
      "defaultValue": "Deny"
    }
  },
  "policyRule": {
    "if": {
      "field": "tags['Owner']",
      "exists": "false"
    },
    "then": {
      "effect": "[parameters('effect')]"
    }
  }
}
