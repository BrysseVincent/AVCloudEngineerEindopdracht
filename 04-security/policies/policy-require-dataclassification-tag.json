{
  "$schema": "https://schema.management.azure.com/schemas/2019-09-01/policyDefinition.json#",
  "name": "require-dataclassification-tag",
  "displayName": "Require tag 'DataClassification' on all resources",
  "description": "Enforces the presence of the required 'DataClassification' tag on all resources. Allowed values: internal, confidential.",
  "mode": "Indexed",
  "metadata": {
    "category": "Tags",
    "version": "1.0.0",
    "author": "Vincent Brysse"
  },
  "parameters": {
    "effect": {
      "type": "String",
      "metadata": {
        "displayName": "Effect",
        "description": "The effect determines what happens when the policy rule is evaluated to match"
      },
      "allowedValues": [
        "Deny",
        "Audit",
        "Disabled"
      ],
      "defaultValue": "Deny"
    }
  },
  "policyRule": {
    "if": {
      "anyOf": [
        {
          "field": "tags['DataClassification']",
          "exists": "false"
        },
        {
          "field": "tags['DataClassification']",
          "notIn": ["internal", "confidential"]
        }
      ]
    },
    "then": {
      "effect": "[parameters('effect')]"
    }
  }
}
